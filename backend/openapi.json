      parameters:
      - in: query
        name: email
        schema:
          type: string
        description: Check for existing account
      - in: query
        name: username
        schema:
          type: string
        description: Check for username availability
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: No response body
        '422':
          description: No response body
