components:
  schemas:
    BlankEnum:
      enum:
      - ''
    Chemical:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        iupac:
          type: string
          nullable: true
          maxLength: 300
        cas:
          type: string
          nullable: true
          maxLength: 13
        formula:
          type: string
          nullable: true
          maxLength: 50
        molecular_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,3})?$
          nullable: true
        is_organic:
          type: boolean
          nullable: true
        storage_category:
          allOf:
          - $ref: '#/components/schemas/Nested'
          readOnly: true
      required:
      - id
      - name
      - storage_category
    ChemicalStorageCategories:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        shorthand:
          type: string
          maxLength: 3
        description:
          type: string
          maxLength: 50
        help_text:
          type: string
      required:
      - description
      - help_text
      - id
      - shorthand
    Container:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        label:
          type: string
          readOnly: true
          title: ID
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          maxLength: 200
        density:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
          nullable: true
          title: Density/specific gravity
        location:
          type: string
          readOnly: true
        manufacturer:
          type: string
          nullable: true
          maxLength: 50
        quantity:
          type: string
          readOnly: true
        initial_quantity:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          title: Quantity
        quantity_unit:
          nullable: true
          title: Unit
          oneOf:
          - $ref: '#/components/schemas/QuantityUnitEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        product_num:
          type: string
          nullable: true
          title: 'Product #'
          maxLength: 25
        date_received:
          type: string
          format: date
          nullable: true
          title: Received on
        is_opened:
          type: boolean
          readOnly: true
          title: Opened?
        latest_reading:
          type: string
          readOnly: true
        percent_remaining:
          type: string
          readOnly: true
      required:
      - id
      - is_opened
      - label
      - latest_reading
      - location
      - name
      - percent_remaining
      - quantity
      - slug
    ContainerWrite:
      type: object
      properties:
        name:
          type: string
          maxLength: 200
        chemical:
          type: integer
        location:
          type: integer
        manufacturer:
          type: string
          nullable: true
          maxLength: 50
        initial_quantity:
          type: integer
          minimum: 0
        quantity_unit:
          nullable: true
          title: Unit
          oneOf:
          - $ref: '#/components/schemas/QuantityUnitEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        product_num:
          type: string
          nullable: true
          title: 'Product #'
          maxLength: 25
        date_received:
          type: string
          format: date
          nullable: true
          title: Received on
        density:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
          nullable: true
          title: Density/specific gravity
        expiration_date:
          type: string
          format: date
          nullable: true
          title: Expires on
        initial_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
        tare_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
          title: Container weight
      required:
      - chemical
      - initial_quantity
      - location
      - name
    InvalidRequest:
      type: object
      properties:
        detail:
          type: string
      required:
      - detail
    Location:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        type:
          type: integer
        parent:
          type: integer
          nullable: true
        full_path:
          type: string
          readOnly: true
      required:
      - full_path
      - id
      - name
      - type
    Nested:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        shorthand:
          type: string
          maxLength: 3
        description:
          type: string
          maxLength: 50
        help_text:
          type: string
      required:
      - description
      - help_text
      - id
      - shorthand
    NewUser:
      type: object
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        lipscomb_id:
          type: string
          nullable: true
          maxLength: 11
        username:
          type: string
          description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
            only.
          pattern: ^[\w.@+-]+$
          maxLength: 150
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
        password:
          type: string
          maxLength: 128
      required:
      - email
      - password
      - username
    NullEnum:
      enum:
      - null
    PatchedChemical:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        iupac:
          type: string
          nullable: true
          maxLength: 300
        cas:
          type: string
          nullable: true
          maxLength: 13
        formula:
          type: string
          nullable: true
          maxLength: 50
        molecular_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,3})?$
          nullable: true
        is_organic:
          type: boolean
          nullable: true
        storage_category:
          allOf:
          - $ref: '#/components/schemas/Nested'
          readOnly: true
    PatchedChemicalStorageCategories:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        shorthand:
          type: string
          maxLength: 3
        description:
          type: string
          maxLength: 50
        help_text:
          type: string
    PatchedContainerWrite:
      type: object
      properties:
        name:
          type: string
          maxLength: 200
        chemical:
          type: integer
        location:
          type: integer
        manufacturer:
          type: string
          nullable: true
          maxLength: 50
        initial_quantity:
          type: integer
          minimum: 0
        quantity_unit:
          nullable: true
          title: Unit
          oneOf:
          - $ref: '#/components/schemas/QuantityUnitEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        product_num:
          type: string
          nullable: true
          title: 'Product #'
          maxLength: 25
        date_received:
          type: string
          format: date
          nullable: true
          title: Received on
        density:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
          nullable: true
          title: Density/specific gravity
        expiration_date:
          type: string
          format: date
          nullable: true
          title: Expires on
        initial_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
        tare_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
          title: Container weight
    PatchedLocation:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        type:
          type: integer
        parent:
          type: integer
          nullable: true
        full_path:
          type: string
          readOnly: true
    QuantityUnitEnum:
      enum:
      - mL
      - L
      - mg
      - g
      - kg
      type: string
      description: |-
        * `mL` - mL
        * `L` - L
        * `mg` - mg
        * `g` - g
        * `kg` - kg
    RoleEnum:
      enum:
      - lab_manager
      - coordinator
      - stockroom
      - viewer
      type: string
      description: |-
        * `lab_manager` - Lab Manager
        * `coordinator` - Coordinator
        * `stockroom` - Stockroom
        * `viewer` - Viewer
    SuccessMessage:
      type: object
      properties:
        detail:
          type: string
      required:
      - detail
    User:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
            only.
          pattern: ^[\w.@+-]+$
          maxLength: 150
        email:
          type: string
          format: email
          maxLength: 254
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
        role:
          allOf:
          - $ref: '#/components/schemas/RoleEnum'
          readOnly: true
      required:
      - email
      - id
      - role
      - username
  securitySchemes:
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
