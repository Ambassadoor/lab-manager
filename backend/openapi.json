components:
  schemas:
    ActionEnum:
      enum:
      - in
      - out
      type: string
      description: |-
        * `in` - Check In
        * `out` - Check Out
    BlankEnum:
      enum:
      - ''
    CheckoutEvent:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/UserCheckoutEvent'
          readOnly: true
        action:
          $ref: '#/components/schemas/ActionEnum'
        timestamp:
          type: string
          format: date-time
          readOnly: true
        related_event:
          type: integer
          nullable: true
      required:
      - action
      - id
      - timestamp
      - user
    Chemical:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        iupac:
          type: string
          nullable: true
          maxLength: 300
        cas:
          type: string
          nullable: true
          maxLength: 13
        formula:
          type: string
          nullable: true
          maxLength: 50
        molecular_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,3})?$
          nullable: true
        is_organic:
          type: boolean
          nullable: true
        storage_category:
          allOf:
          - $ref: '#/components/schemas/Nested'
          readOnly: true
      required:
      - id
      - name
      - storage_category
    ChemicalStorageCategories:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        shorthand:
          type: string
          maxLength: 3
        description:
          type: string
          maxLength: 50
        help_text:
          type: string
      required:
      - description
      - help_text
      - id
      - shorthand
    ChemicalWrite:
      type: object
      properties:
        name:
          type: string
          maxLength: 200
        cas:
          type: string
          nullable: true
          maxLength: 13
        formula:
          type: string
          nullable: true
          maxLength: 50
        molecular_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,3})?$
          nullable: true
        storage_category:
          type: integer
          nullable: true
      required:
      - name
    Container:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        label:
          type: string
          readOnly: true
          title: ID
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          maxLength: 200
        density:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
          nullable: true
          title: Density/specific gravity
        location:
          $ref: '#/components/schemas/Location'
        manufacturer:
          type: string
          nullable: true
          maxLength: 50
        quantity:
          type: string
          readOnly: true
        initial_quantity:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          title: Quantity
        quantity_unit:
          nullable: true
          title: Unit
          oneOf:
          - $ref: '#/components/schemas/QuantityUnitEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        product_num:
          type: string
          nullable: true
          title: 'Product #'
          maxLength: 25
        date_received:
          type: string
          format: date
          nullable: true
          title: Received on
        is_opened:
          type: boolean
          readOnly: true
          title: Opened?
        has_estimated_usage:
          type: string
          readOnly: true
          title: Has Estimated Usage?
        latest_reading:
          type: string
          readOnly: true
        percent_remaining:
          type: string
          readOnly: true
        checkout_status:
          type: string
          readOnly: true
      required:
      - checkout_status
      - has_estimated_usage
      - id
      - is_opened
      - label
      - latest_reading
      - location
      - name
      - percent_remaining
      - quantity
      - slug
    ContainerWrite:
      type: object
      properties:
        name:
          type: string
          maxLength: 200
        chemical:
          type: integer
        location:
          type: integer
        manufacturer:
          type: string
          nullable: true
          maxLength: 50
        initial_quantity:
          type: integer
          minimum: 0
        quantity_unit:
          nullable: true
          title: Unit
          oneOf:
          - $ref: '#/components/schemas/QuantityUnitEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        product_num:
          type: string
          nullable: true
          title: 'Product #'
          maxLength: 25
        date_received:
          type: string
          format: date
          nullable: true
          title: Received on
        density:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
          nullable: true
          title: Density/specific gravity
        expiration_date:
          type: string
          format: date
          nullable: true
          title: Expires on
        initial_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
        tare_weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,4})?$
          nullable: true
          title: Container weight
      required:
      - chemical
      - initial_quantity
      - location
      - name
    InvalidRequest:
      type: object
      properties:
        detail:
          type: string
      required:
      - detail
    Location:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        type:
          $ref: '#/components/schemas/LocationType'
        children:
          type: array
          items:
            type: integer
        full_path:
          type: string
          readOnly: true
      required:
      - children
      - full_path
      - id
      - name
      - type
    LocationMenu:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        full_path:
          type: string
          readOnly: true
      required:
      - full_path
      - id
      - name
    LocationType:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        slug:
          type: string
          maxLength: 40
        description:
          type: string
          nullable: true
          maxLength: 100
        icon:
          type: string
          nullable: true
          maxLength: 25
      required:
      - id
      - name
      - slug
    LocationWrite:
      type: object
      properties:
        name:
          type: string
          maxLength: 20
        type:
          type: integer
        parent:
          type: integer
          nullable: true
      required:
      - name
      - type
    Nested:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        shorthand:
          type: string
          maxLength: 3
        description:
          type: string
          maxLength: 50
        help_text:
          type: string
      required:
      - description
      - help_text
      - id
      - shorthand
    NewUser:
      type: object
      properties:
        email:
          type: string
