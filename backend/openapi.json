openapi: 3.0.3
info:
  title: ''
  version: 0.0.0
paths:
  /api/auth/csrf/:
    get:
      operationId: api_auth_csrf_retrieve
      description: GET once on app load so Django sets the csrftoken cookie.
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessMessage'
          description: ''
  /api/auth/login/:
    post:
      operationId: api_auth_login_create
      description: Session login. Expects {username, password}; returns the user.
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InvalidRequest'
          description: ''
  /api/auth/logout/:
    post:
      operationId: api_auth_logout_create
      description: Ends the current session.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/me/:
    get:
      operationId: api_auth_me_retrieve
      description: Returns the currently authenticated user.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/auth/register/:
    post:
      operationId: api_auth_register_create
      description: |-
        Handles the creation of a new user for authentication

        Method arguments:
        request -- The full HTTP request object
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NewUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/NewUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/NewUser'
        required: true
      security:
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/auth/validate/:
    get:
      operationId: api_auth_validate_retrieve
      description: Validates username availability and checks if account for email
        exists already
      parameters:
      - in: query
        name: email
        schema:
          type: string
        description: Check for existing account
      - in: query
        name: username
        schema:
          type: string
        description: Check for username availability
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: No response body
        '422':
          description: No response body
  /inventory/chemical_storage_categories/:
