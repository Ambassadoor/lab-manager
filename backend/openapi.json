openapi: 3.0.3
info:
  title: ''
  version: 0.0.0
paths:
  /api/auth/csrf/:
    get:
      operationId: api_auth_csrf_retrieve
      description: GET once on app load so Django sets the csrftoken cookie.
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessMessage'
          description: ''
  /api/auth/login/:
    post:
      operationId: api_auth_login_create
      description: Session login. Expects {username, password}; returns the user.
      tags:
      - api
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InvalidRequest'
          description: ''
  /api/auth/logout/:
    post:
      operationId: api_auth_logout_create
      description: Ends the current session.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/me/:
    get:
      operationId: api_auth_me_retrieve
      description: Returns or updates the currently authenticated user's own profile.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
    patch:
      operationId: api_auth_me_partial_update
      description: Returns or updates the currently authenticated user's own profile.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUser'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/auth/register/:
    post:
      operationId: api_auth_register_create
      description: |-
        Handles the creation of a new user for authentication

        Method arguments:
        request -- The full HTTP request object
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NewUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/NewUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/NewUser'
        required: true
      security:
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/auth/users/:
    get:
      operationId: api_auth_users_list
      description: |-
        Admin/Lab Manager viewing and editing *other* users' accounts.

        List/retrieve/update only — no create (registration already covers
        that) and no destroy (account deactivation/deletion isn't in scope
        yet). Every action shares the same LAB_MANAGER+ gate: unlike the
        inventory views, there's no read/write split here — viewing another
        user's info is itself the restricted thing, not just editing it.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - in: query
        name: role
        schema:
          type: string
          enum:
          - admin
          - coordinator
          - faculty
          - lab_assistant
          - lab_manager
          - stockroom
        description: |-
          * `admin` - Admin
          * `lab_manager` - Lab Manager
          * `coordinator` - Coordinator
          * `faculty` - Faculty
          * `stockroom` - Stockroom Worker
          * `lab_assistant` - Lab Assistant
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/UserAdmin'
          description: ''
  /api/auth/users/{id}/:
    get:
      operationId: api_auth_users_retrieve
      description: |-
        Admin/Lab Manager viewing and editing *other* users' accounts.

        List/retrieve/update only — no create (registration already covers
