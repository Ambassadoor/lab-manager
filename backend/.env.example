# Copy to .env and fill in real values. Never commit .env.
DEBUG=True
SECRET_KEY=          # generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=labmanager
DB_USER=labmanager
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

FRONTEND_ORIGIN=http://localhost:5173
# Secure flag on the session/CSRF cookies. Unset = on whenever DEBUG=False.
# Set False only for a production deploy without HTTPS yet.
COOKIE_SECURE=
# True only behind nginx terminating HTTPS (trusts its X-Forwarded-Proto).
TRUST_PROXY_HEADERS=False

# Google Drive (SDS file storage) — a service account with access to a
# shared target folder. See apps/inventory/drive.py.
GOOGLE_SERVICE_ACCOUNT_FILE=
SDS_DRIVE_FOLDER_ID=

# GitHub App for user bug reports -> issues. See docs/Bug-Reporting-Plan.md
# for creating the app. The private key file is the .pem GitHub gives you.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_REPO=Ambassadoor/lab-manager
