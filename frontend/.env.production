# Production build (pnpm build). nginx serves the SPA, the API and the bridge
# from one origin, so both URLs are relative to whatever host served the page.
# Empty, not unset: client.ts uses ??, which keeps '' and yields "/api/...".
VITE_API_URL=
# nginx strips the /bridge prefix before proxying to the bridge on :8200.
VITE_BRIDGE_URL=/bridge
