#!/bin/sh
# Regenerates openapi.json and api.ts and adds them to the commit, so the
# frontend types always match the backend they were generated from.
echo "Updating openapi.json and api.ts" >&2
./scripts/generate-api-types.sh || { echo "Failed to regenerate the API types" >&2; exit 1; }
git add backend/openapi.json frontend/src/types/api.ts || { echo "Failed to stage the API types" >&2; exit 1; }
