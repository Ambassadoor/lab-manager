# Copy to .env and adjust for the lab PC.
FRONTEND_ORIGIN=http://localhost:5173
BALANCE_SERIAL_PORT=COM3
BALANCE_BAUD_RATE=9600
BRIDGE_PORT=8200
# Optional but recommended: the serial number of the USB-to-serial adapter
# cable connecting to the balance (the balance itself speaks plain RS-232
# and has no USB identity of its own), from
# `poetry run python -m serial.tools.list_ports -v`. When set, the bridge
# auto-detects the adapter's current port even if it moves to a different
# USB socket, instead of relying solely on BALANCE_SERIAL_PORT above.
BALANCE_SERIAL_NUMBER=

# Brother PT-P950NW label printer. It must be on the wired network (not
# WiFi — some networks firewall wireless clients off from wired device
# subnets). Find the IP from the printer's own network status screen, or
# its Web Based Management page once you know it: http://<ip>/
PRINTER_IP=
# 9100 is the standard raw/JetDirect print port used by this class of
# network printer; not documented by Brother specifically, so confirm it
# actually connects before assuming it's correct.
PRINTER_PORT=9100
