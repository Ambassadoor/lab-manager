# Copy to .env and adjust for the lab PC.
FRONTEND_ORIGIN=http://localhost:5173
BALANCE_SERIAL_PORT=COM3
BALANCE_BAUD_RATE=9600
BRIDGE_PORT=8200
# Optional but recommended: the serial number of the USB-to-serial adapter
# cable connecting to the balance (the balance itself speaks plain RS-232
# and has no USB identity of its own), from
# `poetry run python -m serial.tools.list_ports -v`. When set, the bridge
# auto-detects the adapter's current port even if it moves to a different
# USB socket, instead of relying solely on BALANCE_SERIAL_PORT above.
BALANCE_SERIAL_NUMBER=

# Brother PT-P950NW label printer. It must be on the wired network (not
# WiFi — some networks firewall wireless clients off from wired device
# subnets). Find the IP from the printer's own network status screen, or
# its Web Based Management page once you know it: http://<ip>/
PRINTER_IP=
# 9100 is the standard raw/JetDirect print port. The printer's Web Based
# Management page (Network > Protocol) must have this protocol set to
# "Raw", not "LPR" — LPR uses a completely different wire protocol on a
# different port (515) and won't work with this bridge.
PRINTER_PORT=9100
# SNMP community string, used only for GET /print/status (printing itself
# doesn't need this — the raw network connection used for printing
# doesn't support status queries at all, confirmed against Brother's docs
# and by testing; SNMP is the actual documented way to reach status over
# the network for this model). "public" is the near-universal default for
# read-only SNMP access; only change this if the printer's SNMP settings
# have been customized.
PRINTER_SNMP_COMMUNITY=public
