# Plain HTTP only redirects. default_server, so a request by IP address or
# to localhost (the Pi's own browser) lands on the real name too.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://app.cplabmanager.com$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name app.cplabmanager.com;

    # Let's Encrypt certificate, issued and renewed by certbot through a
    # Cloudflare DNS challenge (see README.md, HTTPS).
    ssl_certificate     /etc/letsencrypt/live/app.cplabmanager.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.cplabmanager.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Tells a browser to refuse plain HTTP for this name for the next day.
    # Kept short so going back to HTTP stays possible; raise to 31536000
    # (a year) once HTTPS has run cleanly for a while.
    add_header Strict-Transport-Security "max-age=86400" always;

    client_max_body_size 25m;   # SDS PDF uploads

    # Compress API JSON and the frontend bundle. Debian's nginx.conf turns
    # gzip on but only for HTML; a container list is ~1 MB of JSON and ~120 KB
    # compressed. Responses under 1 KB aren't worth it. Vary tells caches the
    # body depends on Accept-Encoding.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    root /opt/lab-manager/frontend/dist;

    # proxy_params sends X-Forwarded-Proto, which Django trusts when
    # TRUST_PROXY_HEADERS=True to know the browser's request was HTTPS.
    location /api/    { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location /admin/  { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location /static/ { alias /opt/lab-manager/backend/staticfiles/; }
    # Trailing slash strips /bridge, so the bridge still sees /health, /print/label, ...
    location /bridge/ { proxy_pass http://127.0.0.1:8200/; include proxy_params; }
    location /        { try_files $uri /index.html; }   # SPA routes
}
