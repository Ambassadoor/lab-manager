# backend/.env for the test site, /opt/lab-manager-test/backend/.env.
# Copy it there and fill in the blanks (README.md, Test site).
#
# What's left out matters as much as what's in: no GitHub App (a bug
# report filed while testing would open a real public issue), no Drive
# backup folder, and no SDS upload folder unless it's a separate test one.

DEBUG=False
# Not the live site's key: a session from one site is no good on the other.
SECRET_KEY=
ALLOWED_HOSTS=test.cplabmanager.com,localhost
FRONTEND_ORIGIN=https://test.cplabmanager.com
TRUST_PROXY_HEADERS=True

# A copy of the live database, made by refresh-test-db.sh.
DB_NAME=labmanager_test
DB_USER=labmanager
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SDS: existing ones still display (they link to Drive files). To try
# uploads, point these at a separate test folder; left empty, uploading
# an SDS shows an error.
GOOGLE_SERVICE_ACCOUNT_FILE=
SDS_DRIVE_FOLDER_ID=

# Never back the test database up, and keep its dumps (if any) apart.
BACKUP_DIR=/var/backups/labmanager-test
BACKUP_DRIVE_FOLDER_ID=

# GITHUB_APP_ID / GITHUB_APP_INSTALLATION_ID / GITHUB_APP_PRIVATE_KEY_FILE:
# deliberately unset.

# For deploy.sh: restart only the test API (the bridge is the live one's)
# and skip the pre-migrate backup.
DEPLOY_SERVICES=labmanager-test-api
DEPLOY_BACKUP=False
